# ── Telegram Bot credentials (required) ─────────────────────────────────────
API_ID=123456
API_HASH=your_api_hash_here
BOT_TOKEN=123456:AAFxxxxxx

# ── MongoDB (required) ────────────────────────────────────────────────────────
DATABASE_URI=mongodb+srv://user:pass@cluster.mongodb.net/?retryWrites=true
DATABASE_NAME=AutoFileSearch
COLLECTION_NAME=Telegram_files
FILE_DB_URI=                          # Leave blank to use DATABASE_URI

# ── Admins & access control ───────────────────────────────────────────────────
ADMINS=123456789 987654321            # Space-separated Telegram user IDs
AUTH_USERS=                           # Extra allowed user IDs
AUTH_CHANNEL=                         # Optional: force-sub channel ID (e.g. -100xxxxxxxxxx)
AUTH_CHANNELS=                        # Comma-separated multi-channel IDs
AUTH_GROUP=                           # Optional: allowed group IDs

# ── Channels indexed by the bot ───────────────────────────────────────────────
CHANNELS=-1001234567890               # Space-separated channel IDs

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_CHANNEL=-1001234567890            # Where the bot logs events

# ── Web server ────────────────────────────────────────────────────────────────
PORT=8080
BASE_URL=https://your-app.koyeb.app   # Full public URL (used for Web App link)

# ── Features ──────────────────────────────────────────────────────────────────
IMDB=True
SPELL_CHECK_REPLY=True
SINGLE_BUTTON=False
P_TTI_SHOW_OFF=False
MELCOW_NEW_USERS=True
PROTECT_CONTENT=True
PUBLIC_FILE_STORE=False
USE_CAPTION_FILTER=False
LONG_IMDB_DESCRIPTION=False

# ── Verification / URL shortener ──────────────────────────────────────────────
VERIFY=False
VERIFY_SHORTLINK_URL=
VERIFY_SHORTLINK_API=
VERIFY_TUTORIAL=https://t.me/Filmykeedha/394

# ── Timing ────────────────────────────────────────────────────────────────────
DLTTM=4200                            # Auto-delete delay in seconds (70 min)
CACHE_TIME=300

# ── Links & branding ─────────────────────────────────────────────────────────
OWNER_USERNAME=your_username
SUPPORT_CHAT=your_support_chat
GRP_LNK=https://t.me/your_group
CHNL_LNK=https://t.me/your_channel
OFR_CNL=https://t.me/your_offer_channel
